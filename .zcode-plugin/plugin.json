{
  "name": "zcode-task-scheduler",
  "version": "0.1.0",
  "description": "任务调度：给已有会话或新会话预定任务，由桌面端调度器到点投递执行",
  "author": { "name": "dreamariner" },
  "license": "Apache-2.0",
  "skills": "skills",
  "commands": "commands",
  "mcpServers": {
    "scheduler": {
      "type": "stdio",
      "command": "node",
      "args": ["${ZCODE_PLUGIN_ROOT}/dist/server.mjs"],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "ZCODE_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "ui": {
    "surfaces": [
      {
        "id": "scheduler",
        "title": { "zh-CN": "任务调度", "en-US": "Task Scheduler" },
        "icon": "clock",
        "server": "scheduler",
        "resourceUri": "ui://zcode-task-scheduler/panel.html",
        "availability": "session"
      }
    ]
  }
}
